---
/**
 * TrajectoryArt: decorative "figure" for the dark research card (Now).
 * Portrait composition: a human hand's keypoint skeleton follows a dotted
 * demonstration path (bottom), crosses a dashed horizontal "embodiment gap"
 * band, and the same motion continues as a parallel-jaw gripper on a solid
 * accent path (top). Onion-skinned snapshots
 * suggest motion capture. Drawn in site ink/paper/accent, labelled
 * "Illustration" (no research content, CV wording only).
 *
 * aria-hidden: it carries no information. The accent path's dashes drift
 * only while the card is hovered or has focus (no endless loop, WCAG 2.2.2;
 * off under reduced motion). The plot grid is the panel's CSS
 * background (NowCard), and the SVG scales with `meet` and overflows, so the
 * art works in tall (desktop) and wide (phone) panels alike.
 * Glyph positions are computed from the Bézier curve below, so editing the
 * curve keeps hands and grippers on it.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'svg'> {
  class?: string;
}

const { class: className, ...rest } = Astro.props;

type Pt = [number, number];
// Two cubic segments forming one S-curve from bottom-left to top-right.
// viewBox 0 0 240 320; the gap band is the horizontal stripe around y = 160.
const A: [Pt, Pt, Pt, Pt] = [
  [34, 288],
  [52, 228],
  [150, 250],
  [124, 160],
];
const B: [Pt, Pt, Pt, Pt] = [
  [124, 160],
  [98, 70],
  [176, 104],
  [206, 36],
];

const bez = ([p0, p1, p2, p3]: [Pt, Pt, Pt, Pt], t: number) => {
  const u = 1 - t;
  const x = u * u * u * p0[0] + 3 * u * u * t * p1[0] + 3 * u * t * t * p2[0] + t * t * t * p3[0];
  const y = u * u * u * p0[1] + 3 * u * u * t * p1[1] + 3 * u * t * t * p2[1] + t * t * t * p3[1];
  const dx = 3 * u * u * (p1[0] - p0[0]) + 6 * u * t * (p2[0] - p1[0]) + 3 * t * t * (p3[0] - p2[0]);
  const dy = 3 * u * u * (p1[1] - p0[1]) + 6 * u * t * (p2[1] - p1[1]) + 3 * t * t * (p3[1] - p2[1]);
  return { x, y, angle: (Math.atan2(dy, dx) * 180) / Math.PI };
};

const d = (s: [Pt, Pt, Pt, Pt]) => `M${s[0].join(' ')}C${s[1].join(' ')} ${s[2].join(' ')} ${s[3].join(' ')}`;

// Snapshots: hands on the demo segment, grippers on the robot segment.
const hands = [0.06, 0.42, 0.8].map((t, i) => ({ ...bez(A, t), opacity: [0.35, 0.6, 0.95][i] }));
const grippers = [0.28, 0.62, 0.98].map((t, i) => ({ ...bez(B, t), opacity: [0.45, 0.7, 1][i] }));
const keypoints = [0.2, 0.3, 0.55, 0.65, 0.9].map((t) => bez(A, t));

---

<svg
  class:list={['traj', className]}
  viewBox="0 0 240 320"
  preserveAspectRatio="xMidYMid meet"
  aria-hidden="true"
  focusable="false"
  {...rest}
>
  {/* embodiment gap band */}
  {/* runs past the viewBox: the SVG overflows into the panel, which clips it */}
  <rect class="traj__gap" x="-600" y="146" width="1440" height="28" />
  <line class="traj__gap-edge" x1="-600" y1="146" x2="840" y2="146" />
  <line class="traj__gap-edge" x1="-600" y1="174" x2="840" y2="174" />

  {/* labels */}
  <text class="traj__label traj__label--end" x="236" y="14">ROBOT EXECUTION</text>
  <text class="traj__label traj__label--gap" x="236" y="163">EMBODIMENT GAP</text>
  <text class="traj__label" x="4" y="314">HUMAN DEMO</text>
  <text class="traj__label traj__label--tiny traj__label--end" x="236" y="314">ILLUSTRATION</text>

  {/* the demonstration (dotted) and the robot execution (accent) */}
  <path class="traj__demo" d={d(A)} />
  <path class="traj__robot-base" d={d(B)} />
  <path class="traj__robot" d={d(B)} />

  {keypoints.map((k) => <circle class="traj__kp" cx={k.x.toFixed(1)} cy={k.y.toFixed(1)} r="2.2" />)}

  {/* hand keypoint skeletons */}
  {
    hands.map((h) => (
      <g
        class="traj__hand"
        transform={`translate(${h.x.toFixed(1)} ${h.y.toFixed(1)}) rotate(${(h.angle * 0.35).toFixed(1)})`}
        opacity={h.opacity}
      >
        <path d="M0 6 L-7 -4 M0 6 L-3 -9 M0 6 L1 -10 M0 6 L5 -8 M0 6 L10 -1" />
        <path d="M-7 -4 L-9 -11 M-3 -9 L-4 -17 M1 -10 L1.5 -18.5 M5 -8 L7 -15.5 M10 -1 L15 -5" />
        <circle cx="0" cy="6" r="2.4" />
        <circle cx="-9" cy="-11" r="1.4" />
        <circle cx="-4" cy="-17" r="1.4" />
        <circle cx="1.5" cy="-18.5" r="1.4" />
        <circle cx="7" cy="-15.5" r="1.4" />
        <circle cx="15" cy="-5" r="1.4" />
      </g>
    ))
  }

  {/* parallel-jaw grippers */}
  {
    grippers.map((g) => (
      <g
        class="traj__gripper"
        transform={`translate(${g.x.toFixed(1)} ${g.y.toFixed(1)}) rotate(${(g.angle + 90).toFixed(1)})`}
        opacity={g.opacity}
      >
        <path d="M0 14 V4 M-9 4 H9 M-9 4 V-10 M9 4 V-10" />
        <rect x="-11.5" y="-14" width="5" height="6" rx="1" />
        <rect x="6.5" y="-14" width="5" height="6" rx="1" />
      </g>
    ))
  }
</svg>

<style>
  .traj {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    color: var(--paper);
  }

  .traj__gap {
    fill: color-mix(in srgb, var(--paper) 5%, transparent);
  }

  .traj__gap-edge {
    stroke: color-mix(in srgb, var(--paper) 35%, transparent);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }

  .traj__label {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 9px;
    letter-spacing: 0.1em;
    fill: color-mix(in srgb, var(--paper) 72%, transparent);
  }

  .traj__label--end {
    text-anchor: end;
    fill: var(--accent);
  }

  .traj__label--gap {
    text-anchor: end;
    font-size: 7.5px;
    fill: color-mix(in srgb, var(--paper) 55%, transparent);
  }

  .traj__label--tiny {
    font-size: 7px;
    fill: color-mix(in srgb, var(--paper) 45%, transparent);
  }

  .traj__demo {
    fill: none;
    stroke: color-mix(in srgb, var(--paper) 80%, transparent);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 0.1 6;
  }

  .traj__robot-base {
    fill: none;
    stroke: color-mix(in srgb, var(--accent) 35%, transparent);
    stroke-width: 1.5;
  }

  .traj__robot {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-dasharray: 14 9;
  }

  .traj__kp {
    fill: var(--dark);
    stroke: var(--paper);
    stroke-width: 1.2;
  }

  .traj__hand {
    fill: none;
    stroke: var(--paper);
    stroke-width: 1.3;
    stroke-linecap: round;
  }

  .traj__hand circle {
    fill: var(--paper);
    stroke: none;
  }

  .traj__gripper {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .traj__gripper rect {
    fill: var(--accent);
    stroke: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.now-card:hover) .traj__robot,
    :global(.now-card:focus-within) .traj__robot {
      animation: traj-flow 2.8s linear infinite;
    }
  }

  @keyframes traj-flow {
    to {
      stroke-dashoffset: -46;
    }
  }
</style>
