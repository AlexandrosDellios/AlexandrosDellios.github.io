---
/**
 * Experience (DESIGN §5.15, content plan §2.6), id="experience".
 * Table-like rows (semantic ordered lists), experience first, then education:
 *
 *   JUL 2026 – NOW   Graduate Research Assistant · BioRob Lab, EPFL
 *                    one line (CV wording) …
 *
 * Layout: designed to work full width AND in the 7-column half of the
 * desktop "Experience | Toolbox" band (pages/index.astro), so rows are a
 * simple two-column grid (dates | content) rather than a 12-column table.
 * The parent provides the container / column; this section adds no gutters.
 *
 * Rows with a `slug` link to their role page (/experience/<slug>/): the role
 * title is the link and it stretches over the whole row.
 *
 * Desktop hover: a small tilted preview card pinned in the dates column, just
 * under the dates, so it never covers the text being read (CursorPreview,
 * data-preview-*). Rows with an `image` (a key in IMAGE_FILES below) show that
 * photo (the AI Team's guide-dog robot, the finished award); rows with `mediaNeeded` + `sketch`
 * show the drawn placeholder (src/assets/sketches/) captioned "Coming soon · …".
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import type { HTMLAttributes } from 'astro/types';
import { site, type ExperienceItem } from '../../data/site';
import { roleHref } from '../project/projects';
import SectionHead from './SectionHead.astro';

interface Props extends HTMLAttributes<'section'> {
  /** Stack the heading (when the section shares a row with another one). */
  stackHead?: boolean;
  class?: string;
}

const { stackHead = false, class: className, ...rest } = Astro.props;

// Preview images by key (glob: a missing file just means no preview). The
// pattern lists only files in use: every image a glob matches is emitted.
const me = import.meta.glob<{ default: ImageMetadata }>(
  ['/src/assets/me/guide-dog.jpg', '/src/assets/projects/mediacom/poster.jpg'],
  { eager: true },
);
const IMAGE_FILES: Record<NonNullable<ExperienceItem['image']>, string> = {
  'guide-dog': '/src/assets/me/guide-dog.jpg',
  award: '/src/assets/projects/mediacom/poster.jpg',
};

// Drawn placeholders, as plain image URLs (vector: nothing to optimise).
const sketches = import.meta.glob<string>('/src/assets/sketches/{arm,award,photo}.svg', {
  query: '?url',
  import: 'default',
  eager: true,
});

const previews = new Map<ExperienceItem, { src: string; label: string }>();
for (const item of [...site.experience, ...site.education]) {
  const src = item.image ? me[IMAGE_FILES[item.image]]?.default : undefined;
  if (src) {
    const img = await getImage({ src, width: 420, format: 'webp' });
    previews.set(item, { src: img.src, label: item.imageLabel ?? `${item.role} · ${item.org}` });
    continue;
  }
  const sketch = item.mediaNeeded && item.sketch ? sketches[`/src/assets/sketches/${item.sketch}.svg`] : undefined;
  if (sketch) previews.set(item, { src: sketch, label: `Coming soon · ${item.mediaNeeded}` });
}

const groups: { key: string; label: string; items: ExperienceItem[] }[] = [
  { key: 'work', label: 'Experience', items: site.experience },
  { key: 'edu', label: 'Education', items: site.education },
];
---

<section class:list={['xp', className]} id="experience" aria-labelledby="experience-title" {...rest}>
  <SectionHead index="04" label="Experience" id="experience-title" title="Experience & *education*" stack={stackHead} />

  {
    groups.map((group) => (
      <div class="xp__group">
        <h3 class="xp__group-label">{group.label}</h3>
        <ol class="xp__list" role="list">
          {group.items.map((item) => {
            const preview = previews.get(item);
            return (
              <li
                class:list={['xp__row', preview && 'has-preview']}
                data-preview-src={preview?.src}
                data-preview-label={preview?.label}
                data-preview-variant={preview ? 'card' : undefined}
              >
                <p class="xp__when">{item.when}</p>
                <div class="xp__main">
                  <p class="xp__role">
                    {/* The " ·" belongs to the title, so a wrapped org never starts a line with it. */}
                    <span class="xp__head">
                      {item.slug ? (
                        <a class="xp__link xp__role-title" href={roleHref(item.slug)}>
                          {item.role}
                        </a>
                      ) : (
                        <span class="xp__role-title">{item.role}</span>
                      )}
                      <span class="xp__dot" aria-hidden="true">{'\u00a0·'}</span>
                    </span>
                    <span class="xp__org">
                      {item.org}
                      {item.slug && <span class="xp__arrow" aria-hidden="true">→</span>}
                    </span>
                  </p>
                  <p class="xp__line">{item.line}</p>
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    ))
  }
</section>

<style>
  .xp {
    display: grid;
    align-content: start;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .xp__group {
    display: grid;
    gap: 0.4rem;
  }

  .xp__group-label {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--fs-label);
    line-height: var(--lh-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .xp__list {
    margin: 0;
    padding: 0;
    border-bottom: var(--hairline);
  }

  .xp__row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.3rem;
    padding-block: clamp(0.8rem, 1.2vw, 0.9rem) clamp(0.85rem, 1.3vw, 1rem);
    border-top: var(--hairline);
  }

  .xp__when {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--fs-label);
    line-height: 1.45;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--accent-ink);
  }

  .xp__role {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.5rem;
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 1.2rem + 0.5vw, 1.625rem);
    line-height: 1.1;
  }

  /* The role title links to the role page and covers the whole row. */
  .xp__link {
    color: inherit;
    text-decoration: none;
  }

  .xp__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .xp__link:focus-visible {
    outline: none;
  }

  .xp__row:has(.xp__link:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .xp__arrow {
    display: inline-block;
    margin-left: 0.25em;
    font-family: var(--font-sans);
    font-size: 0.75em;
    color: var(--accent-ink);
    transition: transform 0.4s var(--ease-out-quart);
  }

  .xp__row:hover .xp__arrow,
  .xp__row:has(.xp__link:focus-visible) .xp__arrow {
    transform: translateX(4px);
  }

  .xp__org {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.3;
    color: var(--ink-2);
  }

  .xp__dot {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  .xp__line {
    margin-top: 0.35rem;
    max-width: 68ch;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
  }

  /* Phones: the org gets its own line (no orphaned "· Mediacom EPFL"), and the
     description is a touch larger (multi-line text, read on a small screen). */
  @media (max-width: 599.98px) {
    .xp__org {
      flex-basis: 100%;
    }

    .xp__dot {
      display: none;
    }

    .xp__line {
      font-size: 0.9375rem;
    }
  }

  /* ≥ 600px: dates | content. The hover fill wipes in from the left. */
  @media (min-width: 600px) {
    .xp__row {
      grid-template-columns: 9.5rem minmax(0, 1fr);
      column-gap: var(--gap);
      align-items: baseline;
      isolation: isolate;
    }

    .xp__row::before {
      content: '';
      position: absolute;
      inset: 0 -0.75rem;
      z-index: -1;
      background: var(--paper-2);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 0.45s var(--ease-out-quart);
    }
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 600px) {
    .xp__row:hover::before {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .xp__row::before,
    .xp__arrow {
      transition: none;
    }
  }
</style>
