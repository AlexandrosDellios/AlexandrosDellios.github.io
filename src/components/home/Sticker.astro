---
/**
 * Sticker (DESIGN §5.5, M1, M9): laptop-style SVG stickers for the hero.
 *
 *   <Sticker kind="tag" />    ink luggage tag "EPFL ✦ ROBOTICS"
 *   <Sticker kind="ring" />   paper disc, ring text "ROBOT LEARNING · MANIPULATION ·"
 *                             around a pixel-art quadruped (the ring turns while hovered)
 *   <Sticker kind="lime" />   lime seal "AVAILABLE SUMMER 2027"
 *
 * Decorative: aria-hidden, never focusable. Availability is also in the header
 * status (and its screen-reader text), the footer, and the hero static line.
 *
 * Structure / hooks:
 *   .sticker            wrapper: absolute position + resting tilt (CSS `rotate`,
 *                       from --tilt) + M1 pop-in (CSS `scale`)
 *   .sticker__drift     [data-sticker-drift]: M9 scroll drift (GSAP transform). Kept
 *                       separate because GSAP folds CSS `rotate`/`scale` into its
 *                       own transform on the element it tweens.
 *   svg[data-sticker-drag]  GSAP Draggable rotation target (desktop, fine pointer;
 *                       scripts/home/stickers.ts). Hard shadows are drawn in the SVG.
 * Position each sticker from the parent with a class (e.g. class="hero__sticker--tag").
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  kind: 'tag' | 'ring' | 'lime';
  /** Index in the M1 pop-in stagger (60 ms steps). */
  order?: number;
  class?: string;
}

const { kind, order = 0, class: className, ...rest } = Astro.props;

/* ---- lime seal: zig-zag edge (alternating radii) -------------------------- */
const sealPath = (cx: number, cy: number, outer: number, inner: number, points: number) => {
  const step = Math.PI / points;
  const pts = Array.from({ length: points * 2 }, (_, i) => {
    const r = i % 2 === 0 ? outer : inner;
    const a = i * step - Math.PI / 2;
    return `${(cx + r * Math.cos(a)).toFixed(2)} ${(cy + r * Math.sin(a)).toFixed(2)}`;
  });
  return `M${pts.join('L')}Z`;
};
const seal = sealPath(100, 100, 94, 86, 22);

/* ---- ring sticker: pixel-art quadruped (facing right) -------------------- */
// '#' ink pixel, 'o' accent pixel (joints / eye). 18 × 10 grid.
const DOG = [
  '..................',
  '.............####.',
  '.#...........#o###',
  '..#############...',
  '..#############...',
  '..##o#######o##...',
  '...#.#......#.#...',
  '..#...#....#...#..',
  '..#...#....#...#..',
  '.##..##...##..##..',
];
const PX = 4.2;
const dogW = DOG[0].length * PX;
const dogH = DOG.length * PX;
const dogX = 100 - dogW / 2;
const dogY = 104 - dogH / 2;
const pixels = DOG.flatMap((row, y) =>
  [...row].flatMap((c, x) => (c === '.' ? [] : [{ x: dogX + x * PX, y: dogY + y * PX, accent: c === 'o' }])),
);

const ringText = 'Robot learning · Manipulation · ';
const ringR = 74;
// Circle drawn clockwise from the top, so the text reads around the rim.
const ringPath = `M100 ${100 - ringR} a${ringR} ${ringR} 0 1 1 0 ${ringR * 2} a${ringR} ${ringR} 0 1 1 0 ${-ringR * 2}`;
const ringId = 'sticker-ring-path';
---

<div class:list={['sticker', `sticker--${kind}`, className]} style={`--order: ${order}`} aria-hidden="true" data-sticker {...rest}>
  <div class="sticker__drift" data-sticker-drift>
    {
      kind === 'tag' && (
        <svg class="sticker__svg" viewBox="0 0 340 104" data-sticker-drag>
          {/* hard shadow */}
          <path
            class="s-ink"
            d="M40 14h282a10 10 0 0 1 10 10v58a10 10 0 0 1-10 10H40L10 66V40Z"
            transform="translate(-5 5)"
          />
          <path
            class="s-ink s-stroke"
            d="M40 14h282a10 10 0 0 1 10 10v58a10 10 0 0 1-10 10H40L10 66V40Z"
          />
          <circle class="s-paper s-stroke" cx="34" cy="53" r="7" />
          <text class="s-display s-paper-text" x="56" y="72" textLength="78" lengthAdjust="spacingAndGlyphs">EPFL</text>
          <path
            class="s-accent"
            transform="translate(146 37) scale(1.25)"
            d="M12 0c.6 6.4 5.6 11.4 12 12-6.4.6-11.4 5.6-12 12-.6-6.4-5.6-11.4-12-12C6.4 11.4 11.4 6.4 12 0Z"
          />
          <text class="s-display s-paper-text" x="190" y="72" textLength="128" lengthAdjust="spacingAndGlyphs">ROBOTICS</text>
        </svg>
      )
    }

    {
      kind === 'ring' && (
        <svg class="sticker__svg" viewBox="0 0 200 200" data-sticker-drag>
          <defs>
            <path id={ringId} d={ringPath} />
          </defs>
          <circle class="s-ink" cx="95" cy="105" r="92" />
          <circle class="s-paper s-stroke" cx="100" cy="100" r="92" />
          <circle class="s-none s-hair" cx="100" cy="100" r="56" />
          <g class="sticker__ring">
            <text class="s-mono">
              <textPath href={`#${ringId}`} textLength={(2 * Math.PI * ringR - 4).toFixed(1)} lengthAdjust="spacing">{ringText.toUpperCase()}</textPath>
            </text>
          </g>
          <g class="sticker__dog">
            {pixels.map((p) => (
              <rect
                class={p.accent ? 's-accent' : 's-ink'}
                x={p.x.toFixed(2)}
                y={p.y.toFixed(2)}
                width={(PX + 0.15).toFixed(2)}
                height={(PX + 0.15).toFixed(2)}
              />
            ))}
            <rect class="s-ink" x={dogX + PX} y={dogY + dogH + 4} width={dogW - PX * 2} height="1.5" opacity="0.35" />
          </g>
        </svg>
      )
    }

    {
      kind === 'lime' && (
        <svg class="sticker__svg" viewBox="0 0 200 200" data-sticker-drag>
          <path class="s-ink" d={seal} transform="translate(-5 5)" />
          <path class="s-lime s-stroke" d={seal} />
          <circle class="s-none s-hair" cx="100" cy="100" r="76" />
          <text class="s-mono s-center" x="100" y="58">✦ OPEN TO INTERNSHIPS ✦</text>
          <text class="s-display s-center" x="100" y="96" textLength="112" lengthAdjust="spacingAndGlyphs">AVAILABLE</text>
          <text class="s-display s-display--xl s-center" x="100" y="140" textLength="128" lengthAdjust="spacingAndGlyphs">SUMMER 2027</text>
          <text class="s-mono s-mono--lg s-center" x="100" y="160">~6 MONTHS</text>
        </svg>
      )
    }
  </div>
</div>

<style>
  .sticker {
    --tilt: 0deg;
    position: absolute;
    z-index: 2;
    rotate: var(--tilt);
    pointer-events: none; /* only the SVG itself is grabbable */
  }

  .sticker__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    pointer-events: auto;
    touch-action: pan-y; /* never block page scrolling on touch */
    -webkit-tap-highlight-color: transparent;
  }

  /* Draggable is attached only on desktop with a fine pointer (stickers.ts). */
  :global(html.has-sticker-drag) .sticker__svg {
    cursor: grab;
  }

  :global(html.has-sticker-drag) .sticker__svg:active {
    cursor: grabbing;
  }

  /* ---- Paint ------------------------------------------------------------- */
  .s-ink {
    fill: var(--ink);
  }

  .s-paper {
    fill: var(--paper);
  }

  .s-lime {
    fill: var(--highlight);
  }

  .s-accent {
    fill: var(--accent);
  }

  .s-none {
    fill: none;
  }

  .s-stroke {
    stroke: var(--ink);
    stroke-width: 2;
  }

  .s-hair {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 2 4;
    opacity: 0.45;
  }

  .s-display {
    font-family: var(--font-display);
    font-size: 36px;
    letter-spacing: 0.01em;
    fill: var(--ink);
  }

  .sticker--tag .s-display {
    font-size: 46px;
  }

  .s-display--xl {
    font-size: 42px;
  }

  .s-paper-text {
    fill: var(--paper);
  }

  .s-mono {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 9.5px;
    letter-spacing: 0.08em;
    fill: var(--ink);
  }

  .s-mono--lg {
    font-size: 11px;
  }

  .sticker--ring .s-mono {
    font-size: 14.5px;
    letter-spacing: 0.12em;
  }

  .s-center {
    text-anchor: middle;
  }

  /* ---- Idle motion (M9): the ring text turns slowly, only while the sticker is
     hovered (no endless decorative loop next to the bio, WCAG 2.2.2). ------ */
  .sticker__ring {
    transform-box: view-box;
    transform-origin: 50% 50%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sticker__ring {
      animation: sticker-spin 40s linear infinite paused;
    }

    .sticker:hover .sticker__ring {
      animation-play-state: running;
    }
  }

  @keyframes sticker-spin {
    to {
      transform: rotate(1turn);
    }
  }

  /* ---- M1 pop-in (after the arch and the bio), back-out ------------------- */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js:not(.reduced-motion):not(.is-ready)) .sticker {
      scale: 0;
    }

    :global(html.js.is-ready:not(.reduced-motion)) .sticker {
      animation: sticker-pop 0.45s calc(0.45s + var(--order) * 60ms) var(--ease-out-back) backwards;
    }
  }

  @keyframes sticker-pop {
    from {
      scale: 0;
    }
  }
</style>
