---
/**
 * NowCard (DESIGN §5.10): one of the two "Now" cards, data from site.now.
 *
 *   variant "dark"    ┌──────────── on-dark ─────────────┬──────────────┐
 *                     │ kicker · serif title · body       │ TrajectoryArt │
 *                     │ role · tags · footnote            │ + media chip  │
 *                     └───────────────────────────────────┴──────────────┘
 *   variant "accent"  ┌──────────── accent fill ─────────────────────────┐
 *                     │ ┌ paper panel ───────────────┐                   │
 *                     │ │ kicker · title · body …    │   cut-out robot    │
 *                     │ └────────────────────────────┘   standing on it   │
 *                     └───────────────────────────────────────────────────┘
 * Fills never carry small text (DESIGN §3.1): on the accent card all copy sits
 * on the paper panel. Phones stack media above the text.
 *
 * Link: with `slug`, the title links to the role page (/experience/<slug>/)
 * and the link stretches over the whole card; a "Read more →" cue closes the
 * text (aria-hidden; the link's name is the title + "(read more)", so voice
 * users can say either). A `link` pill sits above the stretched link.
 *
 * Phones (< 600px) are kept short (the Now section must not push the work
 * grid down): the dark card's decorative art is hidden, the cut-out is
 * smaller, and `bodyShort` (when set) replaces `body`. Both texts are in the
 * HTML; CSS shows one per viewport, so each viewport reads exactly one.
 *
 * Media: `image: 'guide-dog'` loads src/assets/me/guide-dog-cutout.png (or the
 * square photo) through a glob so a missing file falls back to a placeholder.
 * Cards with `mediaNeeded` and no image show the decorative TrajectoryArt
 * (dark) or a MediaPlaceholder (accent); the dark card adds a small
 * "Coming soon · <mediaNeeded>" chip.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import type { HTMLAttributes } from 'astro/types';
import Chip from '../global/Chip.astro';
import Emph from '../global/Emph.astro';
import MediaPlaceholder from '../global/MediaPlaceholder.astro';
import PillButton from '../global/PillButton.astro';
import Segments from '../global/Segments.astro';
import type { NowCard as NowCardData } from '../../data/site';
import { roleHref } from '../project/projects';
import TrajectoryArt from './TrajectoryArt.astro';

interface Props extends HTMLAttributes<'article'> {
  card: NowCardData;
  /** Used to build unique ids. */
  index: number;
  class?: string;
}

const { card, index, class: className, ...rest } = Astro.props;
const titleId = `now-title-${index}`;
const href = card.slug ? roleHref(card.slug) : undefined;

// The pattern lists only files in use: every image a glob matches is emitted.
const me = import.meta.glob<{ default: ImageMetadata }>('/src/assets/me/{guide-dog-cutout.png,guide-dog.jpg}', {
  eager: true,
});
const cutout = card.image ? me[`/src/assets/me/${card.image}-cutout.png`]?.default : undefined;
const photo = card.image ? me[`/src/assets/me/${card.image}.jpg`]?.default : undefined;
const image = cutout ?? photo;
const imageAlt = card.imageAlt ?? '';
---

<article
  class:list={['now-card', `now-card--${card.variant}`, card.variant === 'dark' && 'on-dark', href && 'now-card--linked', className]}
  aria-labelledby={titleId}
  data-enter
  {...rest}
>
  <div class="now-card__text">
    {/* Kicker and role lines break only between their " · " parts (Segments). */}
    <p class="now-card__kicker"><Segments text={card.kicker} /></p>
    <h3 class="now-card__title" id={titleId}>
      {href ? (
        <a class="now-card__stretch" href={href}><Emph text={card.title} /><span class="sr-only"> (read more)</span></a>
      ) : (
        <Emph text={card.title} />
      )}
    </h3>
    <p class:list={['now-card__body', card.bodyShort && 'now-card__body--full']}>{card.body}</p>
    {card.bodyShort && <p class="now-card__body now-card__body--short">{card.bodyShort}</p>}
    <p class="now-card__role"><Segments text={card.role} /></p>
    <ul class="now-card__tags cluster" role="list">
      {card.tags.map((tag) => <Chip as="li" text={tag} />)}
    </ul>
    {card.footnote && <p class="now-card__foot">{card.footnote}</p>}
    {href && <p class="now-card__more" aria-hidden="true">Read more <span class="now-card__more-arrow">→</span></p>}
    {
      card.link && (
        <div class="now-card__link">
          <PillButton href={card.link.href} external={card.link.external} variant="secondary" size="sm">
            {card.link.label}
          </PillButton>
        </div>
      )
    }
  </div>

  <div class:list={['now-card__media', image && cutout && 'now-card__media--cutout']}>
    {
      image ? (
        <Picture
          src={image}
          alt={imageAlt}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[280, 420, image.width]}
          sizes="(min-width: 1024px) 18vw, (min-width: 600px) 30vw, 70vw"
          loading="lazy"
          decoding="async"
          class:list={['now-card__img', cutout ? 'now-card__img--cutout' : 'now-card__img--photo']}
        />
      ) : card.variant === 'dark' ? (
        <TrajectoryArt class="now-card__art" />
      ) : (
        <MediaPlaceholder label={card.mediaNeeded ?? 'Photo'} aspect="auto" class="now-card__ph" />
      )
    }
    {
      card.mediaNeeded && !image && card.variant === 'dark' && (
        <p class="now-card__needed">
          <span class="now-card__needed-kicker">Coming soon</span> · {card.mediaNeeded}
        </p>
      )
    }
  </div>
</article>

<style>
  .now-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    border: var(--border-2);
    border-radius: var(--r-sm);
  }

  /* ---- Text --------------------------------------------------------------------- */
  .now-card__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    padding: clamp(1.25rem, 2vw, 1.75rem);
  }

  .now-card__kicker {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--fs-label);
    line-height: var(--lh-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--accent-ink);
  }

  .now-card--dark .now-card__kicker {
    color: var(--accent);
  }

  .now-card__title {
    max-width: 18ch;
    font-size: clamp(1.625rem, 1.2rem + 1.2vw, 2.375rem);
    line-height: 1.05;
    letter-spacing: var(--track-statement);
  }

  .now-card__body {
    max-width: 60ch;
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  /* The short body is the phone version (see the header comment). */
  .now-card__body--short {
    display: none;
  }

  .now-card__role {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--fs-label);
    line-height: 1.4;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .now-card__tags {
    margin-top: 0.15rem;
    --cluster-gap: 0.4rem;
  }

  .now-card__foot {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.3;
  }

  /* Above the card-wide link (z-index 2), so the pill keeps its own target. */
  .now-card__link {
    position: relative;
    z-index: 3;
    padding-left: 3px;
  }

  /* ---- Whole-card link (role page) ---------------------------------------------- */
  .now-card__stretch {
    color: inherit;
    text-decoration: none;
  }

  .now-card__stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .now-card__stretch:focus-visible {
    outline: none;
    background: none;
  }

  .now-card--linked:has(.now-card__stretch:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }

  .now-card__more {
    margin-top: auto;
    padding-top: 0.25rem;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--fs-label);
    line-height: var(--lh-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .now-card--dark .now-card__more {
    color: var(--accent);
  }

  .now-card__more-arrow {
    display: inline-block;
    transition: transform 0.4s var(--ease-out-quart);
  }

  .now-card--linked:hover .now-card__more-arrow,
  .now-card--linked:has(.now-card__stretch:focus-visible) .now-card__more-arrow {
    transform: translateX(4px);
  }

  .now-card--linked:hover .now-card__title,
  .now-card--linked:has(.now-card__stretch:focus-visible) .now-card__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }

  @media (prefers-reduced-motion: reduce) {
    .now-card__more-arrow {
      transition: none;
    }
  }

  /* ---- Dark variant ------------------------------------------------------------ */
  .now-card--dark {
    border-color: var(--dark);
  }

  .now-card--dark .now-card__role,
  .now-card--dark .now-card__foot {
    color: color-mix(in srgb, var(--paper) 70%, transparent);
  }

  /* Plot-paper grid behind the illustration. */
  .now-card--dark .now-card__media {
    --grid-line: color-mix(in srgb, var(--paper) 8%, transparent);
    position: relative;
    min-height: 17rem;
    overflow: hidden;
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 14%, transparent);
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 2rem 2rem;
    background-position: center;
  }

  .now-card__art {
    position: absolute;
    inset: 1.25rem 1rem 3.25rem;
    width: calc(100% - 2rem);
    height: calc(100% - 4.5rem);
  }

  .now-card__needed {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    max-width: calc(100% - 1.5rem);
    padding: 0.4em 0.6em 0.36em;
    border: 1px solid color-mix(in srgb, var(--paper) 40%, transparent);
    border-radius: var(--r-xs);
    background: var(--dark);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.6875rem;
    line-height: 1.3;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: color-mix(in srgb, var(--paper) 85%, transparent);
  }

  .now-card__needed-kicker {
    color: var(--accent);
  }

  /* ---- Accent variant: copy on a paper panel, robot on the flat fill ------------- */
  .now-card--accent {
    background: var(--accent);
    color: var(--ink);
  }

  .now-card--accent .now-card__text {
    margin: 0 clamp(0.75rem, 1.4vw, 1.25rem) clamp(0.75rem, 1.4vw, 1.25rem);
    border: var(--border);
    border-radius: var(--r-sm);
    background: var(--paper);
    box-shadow: -4px 4px 0 0 var(--ink);
  }

  .now-card--accent .now-card__media {
    display: grid;
    place-items: end center;
    min-height: 13rem;
    padding-top: 1rem;
  }

  /* A definite height (not max-height): with the width/height attributes the
     browser can reserve the box before the lazy image arrives (no layout shift). */
  .now-card__media--cutout :global(img) {
    width: auto;
    max-width: 100%;
    height: 15rem;
    object-fit: contain;
  }

  .now-card__img--photo,
  .now-card__media :global(.now-card__img--photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .now-card :global(.now-card__ph) {
    width: 100%;
    height: 100%;
    min-height: 13rem;
  }

  /* Phones: media first, kept short (the copy is what matters there). */
  .now-card__media {
    order: -1;
  }

  @media (max-width: 599.98px) {
    /* Decorative art + "coming soon" chip: not worth a phone screen. */
    .now-card--dark .now-card__media {
      display: none;
    }

    .now-card--accent .now-card__media {
      min-height: 0;
      padding-top: 0.75rem;
    }

    .now-card__media--cutout :global(img) {
      height: 8rem;
    }

    .now-card__text {
      gap: 0.6rem;
    }

    .now-card__body {
      font-size: var(--fs-body);
      line-height: var(--lh-body);
    }

    .now-card__body--full {
      display: none;
    }

    .now-card__body--short {
      display: block;
    }
  }

  /* ---- ≥ 600px: text and media side by side ------------------------------------- */
  @media (min-width: 600px) {
    .now-card {
      grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    }

    .now-card__media {
      order: 0;
    }

    .now-card--dark .now-card__media {
      min-height: 0;
      border-bottom: 0;
      border-left: 1px solid color-mix(in srgb, var(--paper) 14%, transparent);
    }

    .now-card--accent .now-card__text {
      margin: clamp(0.75rem, 1.4vw, 1.25rem) 0 clamp(0.75rem, 1.4vw, 1.25rem) clamp(0.75rem, 1.4vw, 1.25rem);
    }

    .now-card--accent .now-card__media {
      min-height: 0;
      padding: 1.5rem 0.5rem 0;
      place-items: end center;
    }
  }

  /* Side by side (≥ 760px): the robot stands on the card's bottom edge, fills
     ~70% of its height and bleeds off the right edge (the card clips it).
     Absolutely positioned, so its height can follow the card's (text) height. */
  @media (min-width: 760px) {
    .now-card--accent .now-card__media--cutout {
      position: relative;
      padding: 0;
    }

    .now-card__media--cutout :global(img) {
      position: absolute;
      right: -2.75rem;
      bottom: 0;
      width: auto;
      max-width: none;
      height: min(100% - 1rem, 20rem);
    }
  }

  /* Tablets get the side-by-side split only from 760px; below that the cards stack. */
  @media (min-width: 600px) and (max-width: 759.98px) {
    .now-card {
      grid-template-columns: minmax(0, 1fr);
    }

    .now-card__media {
      order: -1;
      min-height: 13rem;
    }

    .now-card--accent .now-card__text {
      margin: 0 1rem 1rem;
    }
  }
</style>
