---
/**
 * NowSection (DESIGN §4 "Now", content plan §2.3): two cards side by side
 * (6 + 6 columns on desktop, stacked below 1024px). Data: site.now. Each card
 * links to its role page (/experience/<slug>/).
 * Sits right under the hero so its top peeks into the first screen.
 */
import { site } from '../../data/site';
import NowCard from './NowCard.astro';
import SectionHead from './SectionHead.astro';
---

<section class="now container" id="now" aria-labelledby="now-title">
  <SectionHead index="01" label="Now" id="now-title" title="What I’m doing *now*" aside="Research & prototyping" />
  <div class="now__grid">
    {site.now.map((card, i) => <NowCard card={card} index={i} class="now__card" />)}
  </div>
</section>

<style>
  .now {
    display: grid;
    gap: clamp(1rem, 2vw, 1.75rem);
    padding-block: clamp(0.5rem, 1.5vw, 1rem) var(--home-gap, var(--section-sm));
  }

  .now__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap);
    align-items: stretch;
  }

  @media (min-width: 1024px) {
    .now__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
