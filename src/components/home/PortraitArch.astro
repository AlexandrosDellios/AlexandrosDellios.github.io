---
/**
 * PortraitArch (DESIGN §5.4, M1, M2): an accent "D" shape (flat left side,
 * half-circle right side) with the cut-out portrait standing in it. The head
 * breaks out above the shape (Cyd Stumpel's hero), while the shoulders are
 * clipped by the curve.
 *
 *   ┌──────────────┐  <- the cut-out's hair/forehead are visible above the shape
 *   │   (portrait)  ╲
 *   │ ███ accent ██  )   <- shoulders below the circle's centre line are masked
 *   └──────────────╱      by the same D geometry
 *
 * Geometry (all in % of the arch box, which has a fixed aspect ratio):
 *   --t   shape top, fraction of the box height (space for the head to break out)
 *   --a   box aspect H/W (drives aspect-ratio below). Set from the parent with
 *         --arch-a (default 1.2 = a 5:6 box; the desktop hero uses 1 = square)
 *   --k   right inset of the D, fraction of the width (16% at rest; the home
 *         script scrubs it to 0 while the name strip collapses, M2)
 * The D's right side is a half circle of radius (1 - t)·H / 2. The photo uses a
 * union of three mask layers: everything above the circle's centre line, the
 * rectangle left of the centre, and the circle itself.
 *
 * Image: src/assets/me/portrait-cutout.png (produced by the media pass). Only
 * that file is imported, so the uncut photo is never published. Falls back to
 * a MediaPlaceholder if the cut-out is missing.
 * The portrait is the LCP image: eager + fetchpriority high.
 *
 * Hooks: [data-arch] (scripts/home/hero.ts tweens --k). Children passed in the
 * default slot are positioned by the parent (stickers on mobile).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import MediaPlaceholder from '../global/MediaPlaceholder.astro';

import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  class?: string;
}

const { class: className, ...rest } = Astro.props;

// Loaded with a glob so a missing file degrades gracefully instead of failing the build.
// The pattern names the one file in use: every image a glob matches is emitted.
const me = import.meta.glob<{ default: ImageMetadata }>('/src/assets/me/portrait-cutout.png', { eager: true });
const cutout = me['/src/assets/me/portrait-cutout.png']?.default;

const alt = 'Alexandros Dellios, smiling, in a blue polo shirt';
// Rendered width (Hero.astro): ~30vw on desktop, ~48vw on tablets, ≤ 60vw on phones.
const sizes = '(min-width: 1024px) 32vw, (min-width: 600px) 48vw, 60vw';
---

<div class:list={['arch', className]} data-arch {...rest}>
  <div class="arch__shape" aria-hidden="true"></div>
  {
    cutout ? (
      <div class="arch__cutout">
        <Picture
          src={cutout}
          alt={alt}
          formats={['avif', 'webp']}
          widths={[360, 540, 720, cutout.width]}
          sizes={sizes}
          fallbackFormat="webp"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="arch__img"
        />
      </div>
    ) : (
      <MediaPlaceholder label="Portrait · cut-out PNG" aspect="auto" class="arch__ph" />
    )
  }
  <slot />
</div>

<style>
  .arch {
    /* Geometry (see the header comment). --a must equal the aspect ratio. */
    --t: 0.3;
    --a: var(--arch-a, 1.2);
    --k: 0.16;
    --rw: calc((1 - var(--t)) * var(--a) / 2); /* circle radius / box width */
    --rh: calc((1 - var(--t)) / 2); /* circle radius / box height */
    --cx: calc(1 - var(--k) - var(--rw)); /* circle centre x / width */
    --cy: calc(var(--t) + var(--rh)); /* circle centre y / height */

    position: relative;
    aspect-ratio: 1 / var(--a);
    width: 100%;
  }

  /* The accent D. clip-path radii larger than the box collapse to a half circle. */
  .arch__shape {
    position: absolute;
    inset: calc(var(--t) * 100%) 0 0 0;
    background: var(--accent);
    clip-path: inset(0 calc(var(--k) * 100%) 0 0 round 0 999px 999px 0);
  }

  .arch__cutout {
    position: absolute;
    inset: 0;
  }

  /* Head breaks out above the shape; shoulders follow the D's curve. */
  .arch__cutout {
    -webkit-mask:
      linear-gradient(#000 0 0) 0 0 / 100% calc(var(--cy) * 100%) no-repeat,
      linear-gradient(#000 0 0) 0 0 / calc(var(--cx) * 100%) 100% no-repeat,
      radial-gradient(
          calc(var(--rw) * 100%) calc(var(--rh) * 100%) at calc(var(--cx) * 100%) calc(var(--cy) * 100%),
          #000 calc(100% - 0.75px),
          transparent 100%
        )
        0 0 / 100% 100% no-repeat;
    mask:
      linear-gradient(#000 0 0) 0 0 / 100% calc(var(--cy) * 100%) no-repeat,
      linear-gradient(#000 0 0) 0 0 / calc(var(--cx) * 100%) 100% no-repeat,
      radial-gradient(
          calc(var(--rw) * 100%) calc(var(--rh) * 100%) at calc(var(--cx) * 100%) calc(var(--cy) * 100%),
          #000 calc(100% - 0.75px),
          transparent 100%
        )
        0 0 / 100% 100% no-repeat;
  }

  /* The cut-out is (almost) square: full width, standing on the shape's base. */
  .arch__cutout :global(picture),
  .arch__cutout :global(img) {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: auto;
  }

  .arch :global(.arch__ph) {
    position: absolute;
    inset: 0;
    width: auto;
    border-radius: 999px 999px var(--r-sm) var(--r-sm);
  }

  /* No CSS masks: clip the photo to the D (no break-out, but still tidy). */
  @supports not ((mask-image: linear-gradient(#000 0 0)) or (-webkit-mask-image: linear-gradient(#000 0 0))) {
    .arch__cutout {
      clip-path: inset(0 calc(var(--k) * 100%) 0 0 round 0 999px 999px 0);
    }
  }

  /* ---- M1 intro: the shape wipes in from the left, the portrait rises into it.
     Transform/clip only (no opacity on the LCP image). */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js:not(.reduced-motion):not(.is-ready)) .arch__shape {
      clip-path: inset(0 100% 0 0 round 0 999px 999px 0);
    }

    :global(html.js:not(.reduced-motion):not(.is-ready)) .arch__cutout :global(img) {
      translate: 0 14%;
    }

    :global(html.js.is-ready:not(.reduced-motion)) .arch__shape {
      animation: arch-wipe 0.9s 0.15s var(--ease-out-quart) backwards;
    }

    :global(html.js.is-ready:not(.reduced-motion)) .arch__cutout :global(img) {
      animation: arch-rise 1s 0.2s var(--ease-out-quart) backwards;
    }
  }

  @keyframes arch-wipe {
    from {
      clip-path: inset(0 100% 0 0 round 0 999px 999px 0);
    }
  }

  @keyframes arch-rise {
    from {
      translate: 0 14%;
    }
  }
</style>
