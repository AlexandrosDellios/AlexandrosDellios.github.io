---
/**
 * ProjectBody: the Markdown body of a project (Approach / Highlights / Notes)
 * as numbered sections, with the "Development cycle" timeline (data.timeline,
 * ProcessTimeline.astro) and the Footage & figures gallery inserted before
 * the Notes (content plan §3: approach -> results -> credits).
 *
 *   <ProjectBody entry={entry} showSoon={hero !== 'placeholder'} />
 *
 * Layout (12-col grid >= 1024px):
 *   cols 1-3   sticky section label: "01" + serif <h2> (M4 line reveal)
 *   cols 4-10  reading column, max 62ch
 *   cols 4-12  the gallery breaks out wider than the text (to the right edge),
 *              and so do the Highlights (a two-column metric grid)
 * Tablet / phone: label above, single column; figures go full-bleed on phones.
 *
 * Typographic treatments (all CSS, on top of the rendered Markdown):
 *   <ol>   numbered steps as telemetry counters "01 / 05" (--steps is set by
 *          splitSections() in projects.ts)
 *   Highlights <ul>: the bold lead-in of each item becomes a serif metric
 *          with an accent marker underneath
 *   Notes  quieter credits text
 * If the body has no <h2> (or no pre-rendered HTML), it renders as one block.
 *
 * Media still to come: drawn "Coming soon" cards (data.soon) and a slim drawn
 * band (data.mediaNeeded, unless the hero already shows it) in the gallery,
 * which then exists even when it holds nothing else (DECISIONS 2026-10-23:
 * every missing picture gets a drawn placeholder).
 */
import { render } from 'astro:content';
import ProcessTimeline from './ProcessTimeline.astro';
import ProjectGallery from './ProjectGallery.astro';
import { sketchFor } from '../global/sketches';
import { splitSections, type Project } from './projects';

interface Props {
  entry: Project;
  /** Pass false when the hero itself is the mediaNeeded placeholder. */
  showSoon?: boolean;
}

const { entry, showSoon = true } = Astro.props;
const { data } = entry;

const html = entry.rendered?.html;
const split = html ? splitSections(html) : { intro: '', sections: [] };
// Fallback: no pre-rendered HTML (e.g. a future MDX entry) -> Astro's renderer.
const Fallback = html ? null : (await render(entry)).Content;

const sections = split.sections;
const notesAt = sections.findIndex((s) => s.kind === 'notes');
const insertAt = notesAt === -1 ? sections.length : notesAt;

const hasVideos = data.extraVideos.length > 0;
const hasFigures = data.figures.length > 0;
const hasSoonCards = data.soon.length > 0;
const hasSoon = showSoon && Boolean(data.mediaNeeded);
const hasGallery = hasVideos || hasFigures || hasSoonCards || hasSoon;
// One italic phrase per heading, like the Markdown sections (The *approach*, *Notes*).
// Named after what the gallery holds, "Coming soon" placeholders included
// (their drawing says what they are: a clip, a plot or a photo).
const soonKinds = [
  ...data.soon.map(sketchFor),
  ...(hasSoon && data.mediaNeeded ? [data.sketch ?? sketchFor(data.mediaNeeded)] : []),
];
const clips = hasVideos || soonKinds.includes('video');
const figs = data.figures.some((f) => !f.photo) || soonKinds.includes('plot');
// Photos: real photo figures and drawn photo cards (`soon`); a lone placeholder band does not retitle the gallery.
const photos = data.figures.some((f) => f.photo) || data.soon.map(sketchFor).some((k) => k !== 'video' && k !== 'plot');
const galleryTitle = clips
  ? figs
    ? 'Footage & *figures*'
    : photos
      ? 'Photos & *footage*'
      : '*Footage*'
  : figs
    ? photos
      ? 'Figures & *photos*'
      : '*Figures*'
    : '*Photos*';
const [galleryLead, galleryEm] = galleryTitle.split('*');
---

<div class="pj-body">
  {
    split.intro && (
      <div class="pj-sec pj-sec--intro">
        <div class="pj-sec__body pj-prose" set:html={split.intro} />
      </div>
    )
  }

  {
    sections.slice(0, insertAt).map((s) => (
      <section class:list={['pj-sec', `pj-sec--${s.kind}`]} aria-labelledby={s.id}>
        <div class="pj-sec__head">
          <h2 id={s.id} class="pj-sec__title" data-reveal="lines" set:html={s.titleHtml} />
        </div>
        <div class="pj-sec__body pj-prose" set:html={s.html} />
      </section>
    ))
  }

  {
    data.timeline.length > 0 && (
      <section class="pj-sec pj-sec--timeline" aria-labelledby="pj-timeline">
        <div class="pj-sec__head">
          <h2 id="pj-timeline" class="pj-sec__title" data-reveal="lines">
            Development <em>cycle</em>
          </h2>
        </div>
        <div class="pj-sec__wide">
          <ProcessTimeline stages={data.timeline} />
        </div>
      </section>
    )
  }

  {
    hasGallery && (
      <section class="pj-sec pj-sec--gallery" aria-labelledby="pj-figures">
        <div class="pj-sec__head">
          <h2 id="pj-figures" class="pj-sec__title" data-reveal="lines">
            {galleryLead}
            {galleryEm && <em>{galleryEm}</em>}
          </h2>
        </div>
        <div class="pj-sec__wide">
          <ProjectGallery data={data} showSoon={hasSoon} />
        </div>
      </section>
    )
  }

  {
    sections.slice(insertAt).map((s) => (
      <section class:list={['pj-sec', `pj-sec--${s.kind}`]} aria-labelledby={s.id}>
        <div class="pj-sec__head">
          <h2 id={s.id} class="pj-sec__title" data-reveal="lines" set:html={s.titleHtml} />
        </div>
        <div class="pj-sec__body">
          <div class="pj-prose" set:html={s.html} />
        </div>
      </section>
    ))
  }

  {
    Fallback && (
      <div class="pj-sec pj-sec--intro">
        <div class="pj-sec__body pj-prose">
          <Fallback />
        </div>
      </div>
    )
  }
</div>

<style>
  /* ---- Section frame ---------------------------------------------------------- */
  .pj-body {
    counter-reset: pj-sec;
  }

  .pj-sec {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-top: clamp(2.75rem, 6vw, 5.5rem);
    padding-top: clamp(1.25rem, 2.4vw, 2rem);
    border-top: 1px solid var(--ink);
  }

  .pj-sec:not(.pj-sec--intro) {
    counter-increment: pj-sec;
  }

  .pj-sec--intro {
    border-top: 0;
  }

  .pj-sec__head {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  /* "01", "02", … in the telemetry voice above each heading. */
  .pj-sec__head::before {
    content: counter(pj-sec, decimal-leading-zero);
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--fs-label);
    line-height: var(--lh-label);
    letter-spacing: var(--track-label);
    font-variant-numeric: tabular-nums;
  }

  .pj-sec__title {
    font-size: clamp(2rem, 1.25rem + 2.2vw, 3.5rem);
    line-height: 1;
    letter-spacing: var(--track-serif);
  }

  .pj-sec__body {
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .pj-sec {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--gap);
    }

    .pj-sec__head {
      grid-column: 1 / span 3;
      /* The label stays in view while its section scrolls past. */
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
      align-self: start;
      padding-right: 1rem;
    }

    .pj-sec__body {
      grid-column: 4 / span 7;
    }

    .pj-sec__wide {
      grid-column: 4 / -1;
    }

    .pj-sec--intro .pj-sec__body {
      grid-column: 4 / span 7;
    }
  }

  /* ---- Reading column (rendered Markdown: needs :global) ------------------- */
  .pj-prose {
    max-width: var(--measure);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .pj-prose > :global(* + *) {
    margin-block-start: 1em;
  }

  .pj-prose :global(p) {
    text-wrap: pretty;
  }

  .pj-prose :global(strong) {
    font-weight: 600;
  }

  .pj-prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 0.1em 0.35em;
    border-radius: var(--r-xs);
    background: var(--paper-2);
  }

  .pj-prose :global(:is(ul, ol)) {
    padding-inline-start: 1.25em;
  }

  .pj-prose :global(li + li) {
    margin-block-start: 0.4em;
  }

  .pj-prose :global(li::marker) {
    color: var(--accent-ink);
    font-family: var(--font-mono);
  }

  /* ---- Approach: steps with telemetry counters "01 / 05" ------------------- */
  .pj-prose :global(ol.pj-steps) {
    counter-reset: step;
    list-style: none;
    padding: 0;
    border-bottom: var(--hairline);
  }

  .pj-prose :global(ol.pj-steps > li) {
    counter-increment: step;
    position: relative;
    margin: 0;
    padding-block: 1rem 1.1rem;
    border-top: var(--hairline);
  }

  .pj-prose :global(ol.pj-steps > li::before) {
    content: counter(step, decimal-leading-zero) ' / ' var(--steps, '');
    display: block; /* phones: on its own line above the step */
    width: fit-content;
    margin-bottom: 0.5rem;
    padding: 0.3em 0.5em 0.25em;
    border: 1px solid currentColor;
    border-radius: var(--r-xs);
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--fs-label);
    line-height: 1.2;
    letter-spacing: var(--track-label);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Counter in its own column from tablet up. */
  @media (min-width: 600px) {
    .pj-prose :global(ol.pj-steps > li) {
      padding-left: 6.25rem;
    }

    .pj-prose :global(ol.pj-steps > li::before) {
      position: absolute;
      top: 1.1rem;
      left: 0;
      margin: 0;
    }
  }

  /* ---- Highlights: metric emphasis ---------------------------------------------- */
  .pj-prose :global(ul.pj-highlights) {
    list-style: none;
    padding: 0;
    border-bottom: var(--hairline);
  }

  .pj-prose :global(ul.pj-highlights > li) {
    margin: 0;
    padding-block: 1.1rem 1.2rem;
    border-top: var(--hairline);
  }

  /* The bold lead-in ("29% slopes (≈16°).") becomes a serif metric with an
     accent marker under its lower third; the explanation follows below.
     Only for complete lead-ins: projects.ts adds .has-lead when the bold
     phrase ends with punctuation, otherwise it stays an inline bold phrase. */
  .pj-prose :global(ul.pj-highlights > li.has-lead > strong:first-child) {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--fs-h3);
    line-height: 1.15;
    letter-spacing: -0.005em;
    background-image: linear-gradient(
      to top,
      transparent 0.08em,
      color-mix(in srgb, var(--accent) 42%, transparent) 0.08em 0.42em,
      transparent 0.42em
    );
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  /* Block-in-inline: ends the metric's line and adds a little air. */
  .pj-prose :global(ul.pj-highlights > li.has-lead > strong:first-child::after) {
    content: '';
    display: block;
    height: 0.4rem;
  }

  /* Highlights, desktop: a two-column metric grid across cols 4–12 (one
     screen less to scroll; each item keeps its hairline). */
  @media (min-width: 1024px) {
    .pj-sec--highlights .pj-sec__body {
      grid-column: 4 / -1;
    }

    .pj-sec--highlights .pj-prose {
      max-width: none;
    }

    .pj-sec--highlights .pj-prose :global(ul.pj-highlights) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }

    /* A single bottom line under each column, not under the grid only. */
    .pj-sec--highlights .pj-prose :global(ul.pj-highlights) {
      border-bottom: 0;
    }

    .pj-sec--highlights .pj-prose :global(ul.pj-highlights > li) {
      border-bottom: var(--hairline);
      margin-bottom: -1px; /* rows share one hairline */
    }
  }

  /* ---- Notes / credits ------------------------------------------------------------ */
  .pj-sec--notes .pj-prose {
    color: var(--ink-2);
  }

</style>
