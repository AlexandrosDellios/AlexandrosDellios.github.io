---
/**
 * MetaRow (DESIGN §5.18, content plan §3.2): the project's "spec sheet" in
 * the mono telemetry voice. Projects: Year · Links only (Alexandros,
 * 2026-10-25: context, team and "my part" were too much text; the course and
 * team are on the home tile, and each page's text says what his part was).
 *
 *   <MetaRow data={entry.data} />
 *
 * Links rule (docs/DECISIONS.md): "Code ↗" only for PUBLIC repos with nothing
 * in them that must not be published (report PDFs with student IDs), owned by
 * Alexandros or approved by him (`links.code`); `privateRepo` says "Code: on
 * request" (linking to the contact block).
 *
 * Role pages (kind "role"): When · Organisation · Role, then a "Website ↗"
 * pill when `links.website` is set (projects can use it too).
 * The labels of the dates and the organisation are for screen readers only.
 *
 * Semantics: a <dl>; each pair is wrapped in a <div> (allowed in <dl>).
 */
import PillButton from '../global/PillButton.astro';
import type { ProjectData } from './projects';

interface Props {
  data: Pick<ProjectData, 'kind' | 'year' | 'context' | 'myPart' | 'links' | 'privateRepo'>;
  class?: string;
}

const { data, class: className } = Astro.props;

const items: { label: string; value: string; srLabel?: boolean }[] =
  data.kind === 'role'
    ? [
        { label: 'When', value: data.year, srLabel: true },
        { label: 'Organisation', value: data.context, srLabel: true },
        ...(data.myPart ? [{ label: 'Role', value: data.myPart }] : []),
      ]
    : [{ label: 'Year', value: data.year }];
const code = data.links?.code;
const website = data.links?.website;
---

<dl class:list={['meta', className]}>
  {
    items.map((item) => (
      <div class="meta__item">
        <dt class:list={['meta__label', item.srLabel && 'sr-only']}>{item.label}</dt>
        <dd class="meta__value">{item.value}</dd>
      </div>
    ))
  }
  {
    code ? (
      <div class="meta__item meta__item--link">
        <dt class="sr-only">Links</dt>
        <dd class="meta__value">
          <PillButton href={code} variant="secondary" size="sm" class="meta__pill">
            Code
          </PillButton>
        </dd>
      </div>
    ) : data.privateRepo ? (
      <div class="meta__item">
        <dt class="meta__label">Code</dt>
        <dd class="meta__value">
          <a class="meta__request" href="#contact">on request</a>
        </dd>
      </div>
    ) : null
  }
  {
    website && (
      <div class="meta__item meta__item--link">
        <dt class="sr-only">Website</dt>
        <dd class="meta__value">
          <PillButton href={website} variant="secondary" size="sm" class="meta__pill">
            {data.links?.websiteLabel ?? 'Website'}
          </PillButton>
        </dd>
      </div>
    )
  }
</dl>

<style>
  /* Wrapped row of label/value pairs: "YEAR 2025", then the link pills. */
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 1.25rem;
    margin: 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .meta__item {
    display: flex;
    align-items: baseline;
    gap: 0.55em;
    min-width: 0;
  }

  .meta__label {
    color: var(--ink-2);
    font-weight: 500;
    font-size: var(--fs-label);
    line-height: var(--lh-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .meta__value {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    letter-spacing: 0;
  }

  /* The Code pill keeps the hard shadow visible (shadow points down-left). */
  .meta__item--link {
    padding-left: 3px;
    align-self: center;
  }

  .meta__pill {
    font-family: var(--font-sans);
  }

  /* 44px-tall hit area for the one-line link, without changing the row. */
  .meta__request {
    padding-block: 0.8rem;
    background-origin: content-box;
    background-clip: content-box;
  }

  @media (min-width: 600px) {
    .meta {
      gap: 0.6rem 1.5rem;
    }
  }
</style>
