---
/**
 * LoopVideo (DESIGN §5.20, M6/M7): short muted loop, poster first.
 * Nothing downloads until there is intent: the <source>s carry `data-src` and
 * scripts/core/video.ts attaches them on first hover (fine pointer, inside a
 * [data-video-hover] container), when >= 60% visible (touch screens, or any
 * screen with `autoplay`), or when the play button is pressed.
 * Only one video plays at a time; videos pause off-screen and in hidden tabs;
 * nothing autoplays under reduced motion or Save-Data.
 *
 *   <LoopVideo mp4="/media/uno/loop.mp4" webm="/media/uno/loop.webm"
 *              poster={posterImport} alt="Simulated Uno cards being sorted" label="Uno sim-to-real" />
 *
 * Poster: an imported image (optimised through astro:assets) or a public path.
 * It is an <img> under the video (meaningful alt), so the frame is visible
 * without JS, under reduced motion, and while the video loads. The video fades
 * in once it actually plays (.is-playing).
 *
 * Without JS the poster stays, and a <noscript> "Watch clip" link opens the
 * MP4 in the browser's own player (the sources only carry data-src).
 *
 * Hooks: root [data-loop-video-root] gets .is-playing / .has-frame;
 * <video data-loop-video>; optional [data-video-autoplay] or
 * [data-video-manual] (click to play only) on the video.
 * Styles: src/styles/components.css (.loop-video*).
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import VideoToggle from './VideoToggle.astro';

import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'div'>, 'id'> {
  mp4: string;
  webm?: string;
  poster?: ImageMetadata | string;
  /** Describes what the footage shows (poster alt / video label). */
  alt: string;
  /** Short name for the play/pause button ("Pause video: <label>"). Defaults to alt. */
  label?: string;
  /** CSS aspect-ratio. Use "auto" when the parent sets the size. */
  aspect?: string;
  /** object-position for poster + video, e.g. "50% 30%". */
  focus?: string;
  /** Play when >= 60% visible on ALL devices (not only touch). */
  autoplay?: boolean;
  /** Click to play only: no hover start and no scroll autoplay on any device
   *  (the play button is the only way in). Overrides `autoplay`. */
  manual?: boolean;
  /** Render the play/pause button inside. Set false inside links and render <VideoToggle> outside. */
  controls?: boolean;
  /** Corner for the play/pause button (use the tile's sharp corner). Default bottom-right. */
  controlsAt?: 'bottom-right' | 'bottom-left' | 'top-left' | 'top-right';
  /** Fade back to the poster when paused (e.g. tiles that pause on pointer leave). */
  resetOnPause?: boolean;
  /** Above-the-fold poster: loading="eager". */
  eager?: boolean;
  /** fetchpriority for the poster (default "auto"; "high" only for a true LCP image). */
  fetchpriority?: 'high' | 'low' | 'auto';
  /** `sizes` for the optimised poster. */
  sizes?: string;
  id?: string;
  class?: string;
}

const {
  mp4,
  webm,
  poster,
  alt,
  label = alt,
  aspect = '16/9',
  focus = '50% 50%',
  autoplay = false,
  manual = false,
  controls = true,
  controlsAt = 'bottom-right',
  resetOnPause = false,
  eager = false,
  fetchpriority = 'auto',
  sizes = '(min-width: 1024px) 60vw, 100vw',
  class: className,
  id: _id,
  ...rest
} = Astro.props;

// Stable-ish id derived from the file path (unique enough per page).
const slug = mp4
  .replace(/^\/?media\//, '')
  .replace(/\.[a-z0-9]+$/i, '')
  .replace(/[^a-z0-9]+/gi, '-')
  .toLowerCase();
const id = Astro.props.id ?? `video-${slug}`;
const posterIsImport = typeof poster === 'object' && poster !== null;
---

<div
  class:list={['loop-video', className]}
  style={`--aspect: ${aspect}; --focus: ${focus}`}
  data-loop-video-root
  data-reset-on-pause={resetOnPause ? '' : undefined}
  data-controls-at={controlsAt}
  {...rest}
>
  {
    posterIsImport ? (
      <Image
        class="loop-video__poster"
        src={poster as ImageMetadata}
        alt={alt}
        widths={[480, 800, 1200, 1600]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={fetchpriority}
        decoding="async"
      />
    ) : poster ? (
      <img
        class="loop-video__poster"
        src={poster as string}
        alt={alt}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={fetchpriority}
        decoding="async"
      />
    ) : null
  }
  <video
    id={id}
    class="loop-video__video"
    muted
    loop
    playsinline
    preload="none"
    disablepictureinpicture
    disableRemotePlayback
    data-loop-video
    data-video-autoplay={autoplay && !manual ? '' : undefined}
    data-video-manual={manual ? '' : undefined}
    aria-hidden={poster ? 'true' : undefined}
    aria-label={poster ? undefined : alt}
    tabindex="-1"
  >
    {webm && <source data-src={webm} type="video/webm" />}
    <source data-src={mp4} type="video/mp4" />
  </video>
  {controls && <VideoToggle target={id} label={label} class="loop-video__toggle" />}
  {/* Not inside links (tiles pass controls={false}): no nested <a>. */}
  {
    controls && (
      <noscript>
        <a class="pill pill--secondary pill--sm loop-video__nojs" href={mp4} target="_blank" rel="noopener">
          Watch clip<span class="sr-only">: {label} (MP4, opens in a new tab)</span>
        </a>
      </noscript>
    )
  }
</div>
