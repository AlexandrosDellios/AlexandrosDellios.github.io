---
/**
 * Icon: small inline SVG icon set (no icon font, no extra requests).
 *
 * Usage:
 *   <Icon name="arrow-up-right" />                 decorative (aria-hidden)
 *   <Icon name="github" label="GitHub" />          meaningful (role="img" + aria-label)
 *   <Icon name="copy" size="1.25em" class="x" />
 *
 * Line icons use stroke="currentColor"; brand marks use fill="currentColor",
 * so every icon takes the text color of its parent.
 */
import type { HTMLAttributes } from 'astro/types';

export type IconName =
  | 'arrow-up-right'
  | 'arrow-right'
  | 'arrow-down'
  | 'arrow-up'
  | 'copy'
  | 'check'
  | 'menu'
  | 'close'
  | 'download'
  | 'github'
  | 'linkedin'
  | 'mail'
  | 'play'
  | 'pause'
  | 'star'
  | 'users'
  | 'pin';

interface Props extends Omit<HTMLAttributes<'svg'>, 'name'> {
  name: IconName;
  /** CSS length for width/height. Default 1em (scales with the text). */
  size?: string;
  /** Accessible label. Omit for decorative icons (most of them). */
  label?: string;
  class?: string;
}

const { name, size = '1em', label, class: className, ...rest } = Astro.props;

// Each entry: [kind, inner SVG markup]. 'stroke' icons are 24x24 line drawings.
const ICONS: Record<IconName, ['stroke' | 'fill', string]> = {
  'arrow-up-right': ['stroke', '<path d="M7 17 17 7"/><path d="M8 7h9v9"/>'],
  'arrow-right': ['stroke', '<path d="M4 12h16"/><path d="m14 6 6 6-6 6"/>'],
  'arrow-down': ['stroke', '<path d="M12 4v16"/><path d="m6 14 6 6 6-6"/>'],
  'arrow-up': ['stroke', '<path d="M12 20V4"/><path d="m6 10 6-6 6 6"/>'],
  copy: [
    'stroke',
    '<rect x="8.5" y="8.5" width="12" height="12" rx="2"/><path d="M15.5 8.5V5.5a2 2 0 0 0-2-2h-8a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h3"/>',
  ],
  check: ['stroke', '<path d="m4.5 12.5 5 5 10-11"/>'],
  menu: ['stroke', '<path d="M4 8h16"/><path d="M4 16h16"/>'],
  close: ['stroke', '<path d="m6 6 12 12"/><path d="M18 6 6 18"/>'],
  download: ['stroke', '<path d="M12 3.5v12"/><path d="m6.5 10 5.5 5.5 5.5-5.5"/><path d="M4.5 20.5h15"/>'],
  mail: ['stroke', '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>'],
  play: ['fill', '<path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l10.99-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14Z"/>'],
  pause: ['fill', '<rect x="6" y="4.5" width="4" height="15" rx="1"/><rect x="14" y="4.5" width="4" height="15" rx="1"/>'],
  // Four-point "sparkle" star used as a separator (the ✦ of the ticker).
  star: ['fill', '<path d="M12 0c.6 6.4 5.6 11.4 12 12-6.4.6-11.4 5.6-12 12-.6-6.4-5.6-11.4-12-12C6.4 11.4 11.4 6.4 12 0Z"/>'],
  users: [
    'stroke',
    '<circle cx="9" cy="8.5" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 5.2a3.5 3.5 0 0 1 0 6.6"/><path d="M18.5 14.4A6.5 6.5 0 0 1 21.5 20"/>',
  ],
  pin: ['stroke', '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>'],
  // Brand marks (simple-icons paths, CC0).
  github: [
    'fill',
    '<path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .32.21.69.82.57A12 12 0 0 0 12 .3"/>',
  ],
  linkedin: [
    'fill',
    '<path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/>',
  ],
};

const [kind, markup] = ICONS[name];
const a11y = label ? ({ role: 'img', 'aria-label': label } as const) : ({ 'aria-hidden': 'true' } as const);
const paint =
  kind === 'stroke'
    ? {
        fill: 'none',
        stroke: 'currentColor',
        'stroke-width': '1.75',
        'stroke-linecap': 'round' as const,
        'stroke-linejoin': 'round' as const,
      }
    : { fill: 'currentColor' };
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class:list={['icon', `icon--${name}`, className]}
  focusable="false"
  {...paint}
  {...a11y}
  {...rest}
  set:html={markup}
></svg>
