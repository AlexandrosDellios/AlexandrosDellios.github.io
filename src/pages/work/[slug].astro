---
/**
 * /work/<id>/ : one page per featured project (src/content/projects/<id>.md).
 * Ids starting with "_" are stubs and get no page. Prev/next follow the grid
 * order (data.order) and wrap around. Everything else lives in ProjectLayout.
 */
import type { InferGetStaticPropsType } from 'astro';
import { getProjects } from '../../components/project/projects';
import ProjectLayout from '../../layouts/ProjectLayout.astro';

export async function getStaticPaths() {
  const projects = await getProjects();
  const n = projects.length;
  return projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: projects[(i - 1 + n) % n],
      next: projects[(i + 1) % n],
    },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, prev, next } = Astro.props as Props;
---

<ProjectLayout entry={entry} prev={prev} next={next} />
