---
/**
 * /experience/<id>/ : one page per role (src/content/projects/<id>.md with
 * kind "role"): the BioRob Lab, the EPFL Student AI Team and Mediacom. The
 * home page's Now cards and Experience rows link here. Same template as the
 * project pages (ProjectLayout); prev/next cycle through the roles in `order`.
 */
import type { InferGetStaticPropsType } from 'astro';
import { getRoles } from '../../components/project/projects';
import ProjectLayout from '../../layouts/ProjectLayout.astro';

export async function getStaticPaths() {
  const roles = await getRoles();
  const n = roles.length;
  return roles.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: roles[(i - 1 + n) % n],
      next: roles[(i + 1) % n],
    },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, prev, next } = Astro.props as Props;
---

<ProjectLayout entry={entry} prev={prev} next={next} />
